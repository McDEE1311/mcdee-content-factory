channels:
  - id: "daily_trend_brief"
    name: "Daily Trend Brief"
    niche: "top daily trending topics across news, entertainment, sports, finance, technology, science, public safety, weather, viral internet, and lifestyle"
    target_audience: "regular viewers searching for fast, clear explanations of today's biggest stories"
    max_videos_per_day: 10
    upload_window:
      start_hour: 8
      end_hour: 20
    style:
      tone: "clear, fast, factual, curiosity-driven, no fake hype"
      video_length_minutes: "5-8"
      thumbnail_style: "bold, simple, high contrast, 3-5 words max"
    categories:
      - "breaking news"
      - "entertainment"
      - "sports"
      - "finance"
      - "technology"
      - "science"
      - "weather"
      - "public safety"
      - "viral internet"
      - "lifestyle"
    description: >
      Daily Trend Brief explains the biggest topics people are searching for today.
      Each video gives viewers the context, what happened, why people care,
      what is confirmed, what is uncertain, and what to watch next.
