"""
Pexels API client for fetching stock images and videos.
"""
import logging
import os
import re
import httpx
from typing import List, Dict, Optional
from app.settings import settings

logger = logging.getLogger(__name__)

PEXELS_API = "https://api.pexels.com/v1"


def search_photos(query: str, per_page: int = 5) -> List[Dict]:
    """Search Pexels for photos matching query."""
    key = settings.PEXELS_API_KEY
    if not key:
        logger.warning("[pexels] No API key configured")
        return []
    try:
        r = httpx.get(
            f"{PEXELS_API}/search",
            headers={"Authorization": key},
            params={"query": query, "per_page": per_page, "orientation": "landscape"},
            timeout=10.0,
        )
        if r.status_code == 200:
            photos = r.json().get("photos", [])
            logger.info(f"[pexels] '{query}': {len(photos)} photos")
            return photos
        else:
            logger.warning(f"[pexels] Search failed {r.status_code}: {query}")
            return []
    except Exception as e:
        logger.warning(f"[pexels] Error: {e}")
        return []


def download_photo(photo: Dict, output_path: str, size: str = "large") -> bool:
    """Download a Pexels photo to disk."""
    url = photo.get("src", {}).get(size) or photo.get("src", {}).get("medium")
    if not url:
        return False
    try:
        os.makedirs(os.path.dirname(output_path), exist_ok=True)
        r = httpx.get(url, timeout=30.0, follow_redirects=True)
        if r.status_code == 200:
            with open(output_path, "wb") as f:
                f.write(r.content)
            return True
    except Exception as e:
        logger.warning(f"[pexels] Download failed: {e}")
    return False


def extract_scene_queries(script_text: str, title: str, max_scenes: int = 12) -> List[str]:
    """Extract visual search queries from script text."""
    queries = []

    # Always start with topic-based queries
    title_words = re.sub(r'[^\w\s]', '', title).lower()
    queries.append(title_words[:50])

    # Extract key nouns/phrases from script sections
    sections = re.split(r'\[.*?\]', script_text)
    for section in sections:
        words = section.strip().split()
        if len(words) < 10:
            continue
        # Take first meaningful phrase from each section
        phrase = ' '.join(words[:6])
        phrase = re.sub(r'[^\w\s]', '', phrase).lower().strip()
        if len(phrase) > 5 and phrase not in queries:
            queries.append(phrase)

    # Add generic fallbacks based on keywords in title
    keyword_map = {
        "bitcoin": ["bitcoin trading", "cryptocurrency market", "digital currency"],
        "ai": ["artificial intelligence technology", "computer neural network", "data center servers"],
        "nvidia": ["gpu chip technology", "computer hardware", "semiconductor manufacturing"],
        "tesla": ["electric vehicle technology", "tesla car", "electric car charging"],
        "spacex": ["rocket launch space", "spacecraft technology", "astronaut space"],
        "crypto": ["cryptocurrency blockchain", "digital finance", "bitcoin trading"],
        "stock": ["stock market trading", "financial market", "wall street trading floor"],
        "elon": ["technology entrepreneur", "electric vehicle", "rocket launch"],
    }
    title_lower = title.lower()
    for kw, fallbacks in keyword_map.items():
        if kw in title_lower:
            queries.extend(fallbacks[:2])
            break

    # Deduplicate and limit
    seen = set()
    unique = []
    for q in queries:
        if q not in seen and len(q) > 3:
            seen.add(q)
            unique.append(q)

    return unique[:max_scenes]


def fetch_scene_images(
    script_text: str,
    title: str,
    output_dir: str,
    max_images: int = 12,
) -> List[str]:
    """
    Fetch images for a script and save to output_dir.
    Returns list of saved image paths.
    """
    os.makedirs(output_dir, exist_ok=True)
    queries = extract_scene_queries(script_text, title, max_scenes=max_images)

    saved_paths = []
    used_ids = set()

    for i, query in enumerate(queries):
        if len(saved_paths) >= max_images:
            break

        photos = search_photos(query, per_page=3)
        for photo in photos:
            if photo["id"] in used_ids:
                continue
            used_ids.add(photo["id"])

            output_path = os.path.join(output_dir, f"scene_{i:02d}_{photo['id']}.jpg")
            if os.path.exists(output_path):
                saved_paths.append(output_path)
                break

            if download_photo(photo, output_path):
                saved_paths.append(output_path)
                logger.info(f"[pexels] Saved scene {i}: {output_path}")
                break

    logger.info(f"[pexels] Total images for '{title[:40]}': {len(saved_paths)}")
    return saved_paths
